<Window x:Class="TanqiuTft.App.LibraryStartupDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="选择阵容库"
        Width="620"
        Height="390"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Grid Margin="34">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock FontSize="24" FontWeight="Bold" Text="选择一个阵容库" />
            <TextBlock Margin="0,8,0,0"
                       Foreground="{StaticResource MutedTextBrush}"
                       Text="应用一次只使用一个阵容库，切换时不会合并数据" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,28,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Style="{StaticResource PrimaryButton}"
                    Click="CreateDefaultButton_Click">
                <StackPanel>
                    <TextBlock HorizontalAlignment="Center" FontSize="16" FontWeight="SemiBold" Text="创建默认阵容库" />
                    <TextBlock Margin="0,8,0,0" HorizontalAlignment="Center" Text="保存在用户文档目录" />
                </StackPanel>
            </Button>

            <Button Grid.Column="2"
                    Style="{StaticResource SecondaryButton}"
                    Click="OpenExistingButton_Click">
                <StackPanel>
                    <TextBlock HorizontalAlignment="Center" FontSize="16" FontWeight="SemiBold" Text="打开已有阵容库" />
                    <TextBlock Margin="0,8,0,0" HorizontalAlignment="Center" Text="选择复制或移动后的目录" />
                </StackPanel>
            </Button>
        </Grid>

        <TextBlock Grid.Row="2"
                   Foreground="{StaticResource MutedTextBrush}"
                   Text="阵容库目录必须完整包含 library.db 和 images 文件夹"
                   TextAlignment="Center" />
    </Grid>
</Window>
