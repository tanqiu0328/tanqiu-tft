<Window x:Class="TanqiuTft.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="紫云院妙妙屋"
        Width="1180"
        Height="760"
        MinWidth="820"
        MinHeight="560"
        Background="{StaticResource WindowBackground}"
        Foreground="{StaticResource TextBrush}"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True"
        Loaded="Window_Loaded"
        DragOver="Window_DragOver"
        Drop="Window_Drop">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#171020" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="36,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel MaxWidth="560" HorizontalAlignment="Left">
                    <TextBlock Text="紫云院妙妙屋" FontSize="26" FontWeight="Bold" />
                    <TextBlock Margin="0,5,0,0"
                               Foreground="{StaticResource MutedTextBrush}"
                               Text="把值得复用的阵容一图流，安稳地留在本地" />
                    <TextBlock x:Name="ActiveLibraryText"
                               Margin="0,7,0,0"
                               Foreground="{StaticResource MutedTextBrush}"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Margin="0,0,10,0"
                            Style="{StaticResource SecondaryButton}"
                            Click="OpenLibraryFolderButton_Click"
                            Content="打开文件夹" />
                    <Button Margin="0,0,10,0"
                            Style="{StaticResource SecondaryButton}"
                            Click="SwitchLibraryButton_Click"
                            Content="切换阵容库" />
                    <Button Style="{StaticResource PrimaryButton}"
                            Click="ImportButton_Click"
                            Content="＋  导入阵容" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="36,28,36,34">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="0,0,0,18">
                <TextBlock Text="我的阵容" FontSize="19" FontWeight="SemiBold" />
                <TextBlock x:Name="CountText"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource MutedTextBrush}" />
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding Lineups}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="334"
                                    Margin="0,0,18,18"
                                    Padding="12"
                                    Background="{StaticResource SurfaceBrush}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="14">
                                <StackPanel>
                                    <Border Height="300" Background="#0B0810" CornerRadius="9">
                                        <Image Source="{Binding Image}"
                                               Margin="8"
                                               Stretch="Uniform"
                                               RenderOptions.BitmapScalingMode="HighQuality" />
                                    </Border>
                                    <TextBlock Margin="4,13,4,3"
                                               FontSize="16"
                                               FontWeight="SemiBold"
                                               Text="{Binding Name}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <Border x:Name="EmptyState"
                    Grid.Row="1"
                    Padding="48"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="16">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border Width="68" Height="68" Background="#2B1C43" CornerRadius="34">
                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="30"
                                   Foreground="{StaticResource PurpleBrush}"
                                   Text="＋" />
                    </Border>
                    <TextBlock Margin="0,22,0,0"
                               HorizontalAlignment="Center"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Text="还没有保存阵容" />
                    <TextBlock Margin="0,9,0,0"
                               HorizontalAlignment="Center"
                               Foreground="{StaticResource MutedTextBrush}"
                               Text="点击“导入阵容”，或把一张 PNG / JPG 拖到这里" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
