<Window x:Class="TanqiuTft.App.ImportLineupDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="导入阵容"
        Width="620"
        Height="720"
        MinWidth="540"
        MinHeight="520"
        Background="{StaticResource WindowBackground}"
        Foreground="{StaticResource TextBrush}"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock x:Name="HeadingText" FontSize="22" FontWeight="Bold" Text="保存阵容" />
            <TextBlock x:Name="DescriptionText" Margin="0,6,0,0"
                       Foreground="{StaticResource MutedTextBrush}"
                       Text="确认阵容一图流，并给它一个唯一的名称" />
        </StackPanel>

        <Border Grid.Row="1"
                Margin="0,20,0,18"
                Padding="10"
                Background="#0B0810"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="12">
            <Grid>
                <Image x:Name="PreviewImage"
                       Stretch="Uniform"
                       RenderOptions.BitmapScalingMode="HighQuality" />
                <TextBlock x:Name="PreviewErrorText"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="#FF9AA8"
                           TextWrapping="Wrap"
                           Visibility="Collapsed" />
            </Grid>
        </Border>

        <StackPanel Grid.Row="2">
            <TextBlock Foreground="{StaticResource MutedTextBrush}" Text="阵容名称" />
            <TextBox x:Name="NameTextBox"
                     Margin="0,8,0,0"
                     Padding="12,10"
                     FontSize="15"
                     Foreground="{StaticResource TextBrush}"
                     Background="{StaticResource SurfaceRaisedBrush}"
                     BorderBrush="{StaticResource BorderBrush}"
                     CaretBrush="{StaticResource TextBrush}" />
            <TextBlock x:Name="FileNameText"
                       Margin="2,8,0,0"
                       Foreground="{StaticResource MutedTextBrush}"
                       TextTrimming="CharacterEllipsis" />
            <TextBlock Margin="0,16,0,0"
                       Foreground="{StaticResource MutedTextBrush}"
                       Text="定阵 Tag（每行或逗号分隔）" />
            <TextBox x:Name="TagsTextBox"
                     Margin="0,8,0,0"
                     MinHeight="58"
                     Padding="12,9"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     Foreground="{StaticResource TextBrush}"
                     Background="{StaticResource SurfaceRaisedBrush}"
                     BorderBrush="{StaticResource BorderBrush}"
                     CaretBrush="{StaticResource TextBrush}" />
            <TextBlock x:Name="SuggestionsLabel"
                       Margin="0,10,0,0"
                       Foreground="{StaticResource MutedTextBrush}"
                       Text="已有 Tag，点击添加" />
            <ItemsControl x:Name="TagSuggestions" Margin="0,7,0,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Margin="0,0,7,7"
                                Padding="9,5"
                                Style="{StaticResource SecondaryButton}"
                                Click="TagSuggestionButton_Click"
                                Content="{Binding}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <StackPanel Grid.Row="3" Margin="0,22,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
            <Button Margin="0,0,10,0"
                    Style="{StaticResource SecondaryButton}"
                    Click="CancelButton_Click"
                    Content="取消" />
            <Button Style="{StaticResource PrimaryButton}"
                    Click="SaveButton_Click"
                    Content="保存阵容" />
        </StackPanel>
    </Grid>
</Window>
